# apps/alexa/config/.env.example
#
# Local development values for connecting the Alexa+ add-on tooling
# (Alexa AI CLI, Local Inspector) to Haven's MCP server. Copy to
# apps/alexa/config/.env and fill in; see apps/alexa/README.md's
# "Local development setup" section for the full walkthrough.
#
# None of this is read by Haven's Python code (haven.mcp.server has its
# own env vars — see .env.example at the repo root). This file only
# documents the values the Alexa+ tooling itself needs.

# Where Haven's MCP server is actually running. During local development
# this is a tunnel URL (apps/alexa/README.md, step 3: "Expose the local
# server through a tunnel"), not http://localhost:8787 directly — Alexa+
# must reach it over the public internet. Once Person A deploys the
# AgentCore endpoint, swap this (and addon.json's integrations[0]
# endpoint) for that production URL instead.
MCP_SERVER_URL=https://REPLACE-WITH-YOUR-TUNNEL-OR-DEPLOYED-URL/mcp

# Only relevant once Haven's MCP server implements bearer-token auth —
# it doesn't yet (see docs/friction-log.md and apps/alexa/README.md,
# "Authentication" section). Left here as a placeholder for when it
# does; there is nothing to set today.
MCP_AUTH_TOKEN=

# Local Inspector port overrides (optional; only needed if the defaults
# below conflict with something else already running).
INSPECTOR_SERVER_PORT=6277
INSPECTOR_CLIENT_PORT=6274
