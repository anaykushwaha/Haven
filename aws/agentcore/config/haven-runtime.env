# Haven AgentCore runtime environment (deployed configuration).
#
# This is the human-readable source for the `envVars` block of the HavenMCP
# runtime in aws/agentcore/HavenRuntime/agentcore/agentcore.json. The two are
# kept in sync by tests/integration/test_aws_flow.py. Edit here, mirror there.
#
# Nothing in this file is a secret. AWS credentials are NEVER configured this
# way: the runtime authenticates to Bedrock and DynamoDB through its AgentCore
# execution role. Cognito client secrets, user passwords and bearer tokens do
# not belong in any committed file.

AWS_REGION=us-west-2

# Planner reasoning backend. "bedrock" = Strands Agent -> Amazon Bedrock with
# structured output. There is no silent fallback to "mock" in the cloud.
HAVEN_PLANNER_BACKEND=bedrock
HAVEN_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
HAVEN_BEDROCK_TEMPERATURE=0.2
HAVEN_BEDROCK_MAX_TOKENS=2048

# Durable memory (explicit preferences + activity history + plans).
HAVEN_PERSISTENCE_BACKEND=dynamodb
HAVEN_DYNAMODB_PREFERENCES_TABLE=HavenPreferences
HAVEN_DYNAMODB_ACTIVITIES_TABLE=HavenActivities
HAVEN_DYNAMODB_PLANS_TABLE=HavenPlans

HAVEN_MAX_PLAN_STEPS=12
HAVEN_LOG_LEVEL=INFO
