{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "HavenRuntimeLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:DescribeLogStreams",
                "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-west-2:*:log-group:/aws/bedrock-agentcore/runtimes/*"
        },
        {
            "Sid": "HavenDescribeLogGroups",
            "Effect": "Allow",
            "Action": "logs:DescribeLogGroups",
            "Resource": "*"
        }
    ]
}
