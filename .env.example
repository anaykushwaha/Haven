# AWS authentication is resolved by the standard credential chain.
# Never put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in committed files.
AWS_PROFILE=haven-dev
AWS_REGION=us-west-2

# Planner reasoning backend: "mock" (offline, deterministic, default) or
# "bedrock" (Strands -> Amazon Bedrock). Selection is explicit; Haven never
# switches to Bedrock just because credentials are present.
HAVEN_PLANNER_BACKEND=mock
HAVEN_MAX_PLAN_STEPS=12
HAVEN_LOG_LEVEL=INFO

# Used only when HAVEN_PLANNER_BACKEND=bedrock
HAVEN_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
HAVEN_BEDROCK_TEMPERATURE=0.2
HAVEN_BEDROCK_MAX_TOKENS=2048

# Persistence backend: "memory" (local/offline, default) or "dynamodb".
HAVEN_PERSISTENCE_BACKEND=memory
HAVEN_DYNAMODB_PREFERENCES_TABLE=HavenPreferences
HAVEN_DYNAMODB_ACTIVITIES_TABLE=HavenActivities
HAVEN_DYNAMODB_PLANS_TABLE=HavenPlans
# Local DynamoDB only (never set for the deployed runtime):
# HAVEN_DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Live AgentCore tests (`pytest -m aws_live`) read these from your shell only.
# Never write a real bearer token into any file.
# HAVEN_AWS_LIVE=1
# HAVEN_AGENTCORE_RUNTIME_URL=https://bedrock-agentcore.us-west-2.amazonaws.com/runtimes/<url-encoded runtime ARN>/invocations?qualifier=DEFAULT
# HAVEN_AGENTCORE_BEARER_TOKEN=<Cognito access token, from your shell>
